{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@/lib/audio/*": ["./vendor/*"],
      "@/lib/orbit-logo": ["./vendor/ui/orbit-logo.ts"],
      "@/components/ui/button": ["./web/button.jsx"]
    }
  },
  "include": ["vendor/**/*.ts", "vendor/**/*.tsx"]
}
